# Site root of the secret album (felps.dev/fogueira-53f12a/).
# Apache/LiteSpeed only; every directive is guarded so a missing module cannot
# turn the whole folder into a 500.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    # Secret path, but search engines still get told to stay out.
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, noimageindex"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    # index.html points at hashed bundles: it must never be used from cache
    # after a new deploy replaced them.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Nothing private is served from the root: dotfiles, logs, locks, backups.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "(\.(log|lock|bak|tmp|ini|json)$|^error_log$|^php_errorlog$|^Dockerfile|^README\.md$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
</IfModule>

# Single-page app: a refresh on any path must come back as the app, not as the
# server's own 404. Real files, the API and the uploads are left alone.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} (^|/)(api|uploads|data|assets)/ [NC]
    RewriteRule ^ - [L]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.html [L]
</IfModule>
