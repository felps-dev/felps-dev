# felps.dev/mudanca/ — every directive is guarded so a missing module cannot
# turn the whole folder into a 500.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    # index.html points at hashed bundles: never reuse it from cache after a deploy.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<FilesMatch "(^\.|\.(log|lock|bak|tmp|ini|json)$|^error_log$|^php_errorlog$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
